# VSCode + Python .gitignore 框架

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.env
.venv/
venv/
env/
ENV/
venv.bak/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Type checkers / caches
.mypy_cache/
.dmypy.json
.dmypy/

# PyInstaller
*.manifest
*.spec

# Jupyter
.ipynb_checkpoints/

# VSCode (忽略大多数本地/临时设置，但保留推荐扩展/任务/启动配置)
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Secrets / environment files
*.env
.env.local
secrets.yml
credentials.json

# Packaging artifacts
*.egg
*.whl

# Sphinx / docs
docs/_build/

# Editor folders
.idea/
*.sublime-workspace
*.sublime-project

# Misc
coverage.xml
*.cover